{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.telemetry.local/schemas/telemetry-raw-event/1.0.json",
  "title": "TelemetryRawEvent",
  "description": "Value of one Kafka record on topic telemetry.raw.v1 (key = resource.instanceId). It is one accepted event of an ingest batch, unchanged, plus three fields added by the gateway: receivedAt, agentId, batchId. Spec CAP-PFE-2026-TEL-084 section 8.3. The event fields must stay identical to $defs/event of telemetry-batch.1.0.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "timestamp", "intervalSeconds", "resource", "metrics",
    "receivedAt", "agentId", "batchId"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "intervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "instanceId", "environment", "region"],
      "properties": {
        "serviceName": { "$ref": "#/$defs/identifier" },
        "instanceId": { "$ref": "#/$defs/identifier" },
        "environment": { "enum": ["dev", "staging", "prod"] },
        "region": { "$ref": "#/$defs/identifier" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuUsagePercent", "memoryUsedBytes", "memoryLimitBytes",
        "networkRxBytesPerSec", "networkTxBytesPerSec",
        "diskReadBytesPerSec", "diskWriteBytesPerSec",
        "activeThreadCount", "httpRequestsPerSec",
        "httpErrorRatePercent", "httpLatencyP95Ms", "gcPauseMsPerMin"
      ],
      "properties": {
        "cpuUsagePercent": { "$ref": "#/$defs/percent" },
        "memoryUsedBytes": { "type": "integer", "minimum": 0 },
        "memoryLimitBytes": { "type": "integer", "minimum": 1 },
        "networkRxBytesPerSec": { "$ref": "#/$defs/nonNegative" },
        "networkTxBytesPerSec": { "$ref": "#/$defs/nonNegative" },
        "diskReadBytesPerSec": { "$ref": "#/$defs/nonNegative" },
        "diskWriteBytesPerSec": { "$ref": "#/$defs/nonNegative" },
        "activeThreadCount": { "type": "integer", "minimum": 0 },
        "httpRequestsPerSec": { "$ref": "#/$defs/nonNegative" },
        "httpErrorRatePercent": { "$ref": "#/$defs/percent" },
        "httpLatencyP95Ms": { "$ref": "#/$defs/nonNegative" },
        "gcPauseMsPerMin": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "receivedAt": {
      "description": "Gateway clock (UTC) when the HTTP request was received. Stored as telemetry_event.received_at.",
      "type": "string", "format": "date-time"
    },
    "agentId": {
      "description": "Agent that sent the batch, as authenticated by its API key.",
      "$ref": "#/$defs/identifier"
    },
    "batchId": {
      "description": "batchId of the ingest request that carried this event (tracing).",
      "type": "string", "format": "uuid"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nonNegative": { "type": "number", "minimum": 0 },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
