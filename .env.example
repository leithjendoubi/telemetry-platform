# Copy to .env and adjust. These are LOCAL DEVELOPMENT values only.
# Spec 11.2: nothing sensitive is committed; real secrets never go in this file.

# --- PostgreSQL / TimescaleDB (one instance, three logical databases: spec 6.3) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only

# One role per logical database (database per service, separate credentials)
INGESTION_DB_USER=ingestion
INGESTION_DB_PASSWORD=ingestion_dev_only
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics_dev_only
ALERTING_DB_USER=alerting
ALERTING_DB_PASSWORD=alerting_dev_only

# --- Ports exposed on the host ---
KAFKA_EXTERNAL_PORT=9092
POSTGRES_PORT=5432
# Application services (8080 is taken by a Pi-hole on the dev machine)
GATEWAY_PORT=8081
ANALYTICS_PORT=8082
