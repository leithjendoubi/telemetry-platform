<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM of the Java services (spec 14.1: "Java services use Maven with a parent POM that pins versions").
  It pins library and plugin versions and holds the shared quality tooling of the CI pipeline (spec 14.4):
    stage 1  spotless:check (palantir-java-format), checkstyle:check
    stage 2  unit tests (surefire, *Test) incl. ArchUnit
    stage 3  dependency-check:check (OWASP; needs NVD_API_KEY)
    stage 5  integration tests (failsafe, *IT, Testcontainers) and the JaCoCo coverage gate
  A service builds alone with  mvn -f services/<name>/pom.xml ...  ; this file is found through relativePath.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.telemetry</groupId>
    <artifactId>telemetry-platform-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>telemetry-platform-parent</name>

    <modules>
        <module>services/ingestion-gateway</module>
        <module>services/analytics-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- libraries -->
        <reactor-kafka.version>1.3.23</reactor-kafka.version>
        <json-schema-validator.version>1.5.6</json-schema-validator.version>
        <archunit.version>1.5.0</archunit.version>
        <!-- token buckets of the gateway's rate limits (spec 6.5, FR-ING-06); 8.22.0 was 2 days old on 2026-11-05 -->
        <bucket4j.version>8.21.0</bucket4j.version>
        <!-- Testcontainers: Boot 3.5.16 manages 1.21.4, the first version that talks to Docker Engine 29+ -->

        <!-- security patches above what Boot 3.5.16 manages: the smallest version that fixes the HIGH/CRITICAL
             findings of the Trivy image scan (CI stage 4, 2026-11-05). Remove each line once Boot manages it. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.59</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
        <!-- compression codecs of kafka-clients 3.9.2 (it declares lz4 1.10.1, snappy 1.1.10.5) -->
        <lz4-java.version>1.11.4</lz4-java.version>
        <snappy-java.version>1.1.10.9</snappy-java.version>

        <!-- quality tooling -->
        <spotless.version>3.10.2</spotless.version>
        <palantir-java-format.version>2.100.0</palantir-java-format.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>14.1.0</checkstyle.version>
        <jacoco.version>0.8.15</jacoco.version>
        <dependency-check.version>13.0.0</dependency-check.version>

        <!-- spec 13.5: Java domain and application code >= 80 % lines, >= 70 % branches -->
        <coverage.line.minimum>0.80</coverage.line.minimum>
        <coverage.branch.minimum>0.70</coverage.branch.minimum>

        <!-- repository root, seen from a service folder (services/<name>) -->
        <repo.root>${project.basedir}/../..</repo.root>
        <!-- this parent has no code of its own; the services set it back to false -->
        <checkstyle.skip>true</checkstyle.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.projectreactor.kafka</groupId>
                <artifactId>reactor-kafka</artifactId>
                <version>${reactor-kafka.version}</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- seen from this folder itself (mvn from the root, e.g. the dependency-check aggregate scan),
             the repository root is the folder itself, not two levels up -->
        <profile>
            <id>at-repo-root</id>
            <activation>
                <file>
                    <exists>${basedir}/config/checkstyle/checkstyle.xml</exists>
                </file>
            </activation>
            <properties>
                <repo.root>${project.basedir}</repo.root>
            </properties>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <!-- stage 1: formatting. Fix locally with  mvn spotless:apply -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat>
                                <version>${palantir-java-format.version}</version>
                            </palantirJavaFormat>
                            <removeUnusedImports/>
                            <importOrder/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>

                <!-- stage 1: lint rules that a formatter cannot fix (config/checkstyle/checkstyle.xml) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${repo.root}/config/checkstyle/checkstyle.xml</configLocation>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                </plugin>

                <!-- stage 5: integration tests are the *IT classes (Testcontainers); unit tests (*Test) stay in surefire -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- coverage of unit + integration tests together, checked at the end of  mvn verify  -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <destFile>${project.build.directory}/jacoco.exec</destFile>
                        <dataFile>${project.build.directory}/jacoco.exec</dataFile>
                        <excludes>
                            <!-- bootstrap and wiring, not domain or application logic -->
                            <exclude>**/*Application.class</exclude>
                            <exclude>**/config/**</exclude>
                            <exclude>**/*Config.class</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>agent-unit</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>agent-integration</id>
                            <goals>
                                <goal>prepare-agent-integration</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>coverage-gate</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.line.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.branch.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!-- stage 3: known vulnerabilities in dependencies. "High or Critical" = CVSS >= 7 -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <skipTestScope>true</skipTestScope>
                        <formats>
                            <format>HTML</format>
                            <format>JSON</format>
                        </formats>
                        <suppressionFiles>
                            <suppressionFile>${repo.root}/config/dependency-check/suppressions.xml</suppressionFile>
                        </suppressionFiles>
                        <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
